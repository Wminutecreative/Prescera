---
/* 4 · WHAT DEFENDERS NEED · continuous, pre-emptive defence across the four workflows */
import Button from "./Button.astro";
import WorkflowTimeline from "./WorkflowTimeline.astro";
---
<section class="sec" id="defenders" aria-labelledby="h-defenders">
  <div class="shell">
    <header class="sec__head sec__head--split">
      <div>
        <h2 id="h-defenders">Defenders need to act at machine speed.</h2>
      </div>
      <p class="lead">That means defence that is continuous and <span class="nowrap">pre-emptive</span>: monitoring and remediating vulnerabilities and threats around the clock, through automated playbooks that stay consistent with your organisation's policies.</p>
    </header>
    <WorkflowTimeline />
    <div class="wf-cta"><Button href="#briefing">Request access</Button></div>
  </div>
</section>
