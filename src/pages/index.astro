---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Belief from "../components/Belief.astro";
import WhatChanged from "../components/WhatChanged.astro";
import Defenders from "../components/Defenders.astro";
import Briefing from "../components/Briefing.astro";
---
<BaseLayout>
  <Hero />
  <Belief />
  <WhatChanged />
  <Defenders />
  <Briefing />
</BaseLayout>

<script>
  /* Order matters: shared data and the 2D twin first, then page behaviour, the stat figures,
     the timeline, and last the loader that brings in the 3D hero straight away (it waits for first paint, then loads three.js). */
  import "../scripts/pl-data.js";
  import "../scripts/page.js";
  import "../scripts/tiles.js";
  import "../scripts/workflow.js";
  import "../scripts/hero-loader.js";
</script>
