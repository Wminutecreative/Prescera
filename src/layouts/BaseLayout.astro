---
/* fonts are self-hosted (no render-blocking request to Google). Only the latin subset downloads, via unicode-range */
import "@fontsource/hanken-grotesk/300.css";
import "@fontsource/hanken-grotesk/400.css";
import "@fontsource/hanken-grotesk/500.css";
import "@fontsource/dm-mono/400.css";
import "@fontsource/dm-mono/500.css";
import "../styles/global.css";
/* the two faces the hero headline and copy use on first paint are preloaded */
import hanken400 from "@fontsource/hanken-grotesk/files/hanken-grotesk-latin-400-normal.woff2?url";
import hanken300 from "@fontsource/hanken-grotesk/files/hanken-grotesk-latin-300-normal.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileBar from "../components/MobileBar.astro";
import Tooltip from "../components/Tooltip.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Prescera Labs · Cybersecurity AI lab",
  description = "AI is putting sophisticated cyberattacks within reach of anyone. Prescera Labs is building foundation models for cyber defence, so defenders can act at machine speed.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Prescera Labs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#111111" />
    <link rel="preload" href={hanken400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={hanken300} as="font" type="font/woff2" crossorigin />
    <!-- reduced motion is read before the first paint, so the page never flashes the animated state -->
    <script is:inline>
      (function () { try { if (matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("no-motion"); } catch (e) {} })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <Tooltip />
  </body>
</html>
