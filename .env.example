# Google Apps Script web app URL (see apps-script/README.md).
# The request-access form posts here; the script adds a row to the Google Sheet and emails the team.
# Leave empty to fall back to a pre-filled email (mailto) like the HTML prototype.
PUBLIC_FORM_ENDPOINT=https://script.google.com/macros/s/AKfycby7kQRc_ca7SPCLkwAqfH4crcFry_94vkIE_NuhjVfE3B94DyDhipLGrZp2MiFwbEH1/exec

# Where the mailto fallback sends requests
PUBLIC_FORM_FALLBACK_EMAIL=kartik@minutecreative.com
