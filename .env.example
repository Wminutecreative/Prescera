# Google Apps Script web app URL (see apps-script/README.md).
# The request-access form posts here; the script adds a row to the Google Sheet and emails the team.
# Leave empty to fall back to a pre-filled email (mailto) like the HTML prototype.
PUBLIC_FORM_ENDPOINT=https://script.google.com/macros/s/AKfycbwnWWRNnQQBui6l1rIwJWiF1b4Pv1qAXEZPi1YuSevMuWxco6352LCW0oiU5f4MeGkPVQ/exec

# Where the mailto fallback sends requests
PUBLIC_FORM_FALLBACK_EMAIL=kartik@minutecreative.com

# Analytics. Each tool loads only when its value is set, and only in production builds.
# Set these in Vercel for the Production environment, so preview deployments stay out of the numbers.
PUBLIC_GA_ID=G-HJSELCS3XQ
# Google Tag Manager container (GTM-XXXXXXX)
PUBLIC_GTM_ID=GTM-5DGT3GVL
# Microsoft Clarity project ID
PUBLIC_CLARITY_ID=zggbwd7ua0
# Contentsquare (formerly Hotjar) tag ID: the part between /uxa/ and .js in its tag URL
PUBLIC_CONTENTSQUARE_ID=f59bd0352a5c2
# PostHog project API key (phc_...) and host (https://us.i.posthog.com or https://eu.i.posthog.com)
PUBLIC_POSTHOG_KEY=phc_B2rgmQnyG2MA5EE3Hq5QyMAH6V9aQ9MxiihmHQJVb2uX
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
