PUBLIC_FORM_ENDPOINT=https://script.google.com/macros/s/AKfycbwnWWRNnQQBui6l1rIwJWiF1b4Pv1qAXEZPi1YuSevMuWxco6352LCW0oiU5f4MeGkPVQ/exec

# Where the mailto fallback sends requests
PUBLIC_FORM_FALLBACK_EMAIL=kartik@minutecreative.com
